# ──────────────────────────────────────────────────────────────────────────────
# AUTOVAULT AI — .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
.conda/
conda-env/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
*.env
*.secret
secrets.toml
.streamlit/secrets.toml

# ── ML Artifacts ──────────────────────────────────────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.onnx
*.pt
*.pth
models/*.pkl
models/*.joblib
models/*.h5

# ── Data (raw and processed — never commit raw PII or large CSVs) ─────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Notebooks (outputs can be large; commit clean notebooks only) ─────────────
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
nosetests.xml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.out

# ── Temporary / OS ────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
desktop.ini

# ── Streamlit cache ───────────────────────────────────────────────────────────
.streamlit/cache/
